<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo de madera -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_home"
        android:scaleType="centerCrop" />

    <!-- Botella girada en el centro -->
    <ImageView
        android:id="@+id/imgBotella"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:src="@drawable/bottel"
        android:rotation="-25"
        android:scaleType="fitCenter" />

    <!-- Número del jugador sobre la botella -->
    <TextView
        android:id="@+id/tvNumeroJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="40dp"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Texto Presióname → va primero para que el botón lo referencie -->
    <TextView
        android:id="@+id/tvPresioname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:text="Presióname"
        android:textColor="#000000"
        android:textSize="30sp" />

    <!-- Botón circular rojo ENCIMA del texto -->
    <View
        android:id="@+id/btnGirar"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@id/tvPresioname"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_circular_rojo"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>