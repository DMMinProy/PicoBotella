<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo de madera -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_home"
        android:scaleType="centerCrop" />

    <!-- Barra de menú superior -->
    <LinearLayout
        android:id="@+id/menuSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_menu_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginVertical="50dp"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnEstrella"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_naranja"            android:src="@drawable/ic_star"
            android:tint="#FF4500"
            android:contentDescription="Favoritos" />

        <ImageButton
            android:id="@+id/btnSonido"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_naranja"            android:src="@drawable/ic_sound"
            android:tint="#FF4500"
            android:contentDescription="Sonido" />

        <ImageButton
            android:id="@+id/btnJuego"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_naranja"            android:src="@drawable/ic_game"
            android:tint="#FF4500"
            android:contentDescription="Juego" />

        <ImageButton
            android:id="@+id/btnAgregar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_naranja"            android:src="@drawable/ic_add"
            android:tint="#FF4500"
            android:contentDescription="Agregar" />

        <ImageButton
            android:id="@+id/btnCompartir"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_naranja"            android:src="@drawable/ic_share"
            android:tint="#FF4500"
            android:contentDescription="Compartir" />

    </LinearLayout>

    <!-- Botella girada en el centro -->
    <ImageView
        android:id="@+id/imgBotella"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:src="@drawable/bottel"
        android:rotation="-25"
        android:scaleType="fitCenter" />

    <!-- Número del jugador sobre la botella -->
    <TextView
        android:id="@+id/tvNumeroJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="40dp"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Texto Presióname → va primero para que el botón lo referencie -->
    <TextView
        android:id="@+id/tvPresioname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:text="Presióname"
        android:textColor="#000000"
        android:textSize="30sp" />

    <!-- Botón circular rojo ENCIMA del texto -->
    <View
        android:id="@+id/btnGirar"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@id/tvPresioname"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_circular_rojo"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>