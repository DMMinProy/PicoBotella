<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_instrucciones.xml
    Coloca este archivo en: res/layout/fragment_instrucciones.xml
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/instrucciones_fondo">

    <!-- Toolbar personalizada -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/instrucciones_toolbar"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarInstrucciones"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/instrucciones_toolbar"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:navigationContentDescription="Volver al inicio"
            app:title="Reglas del Juego"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/ToolbarTitleInstrucciones" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp">

            <!-- Título: Cómo se juega -->
            <TextView
                android:id="@+id/tvTituloComoSeJuega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cómo se juega"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_gravity="start"
                android:background="@color/instrucciones_acento"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDescComoSeJuega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Los jugadores forman un círculo y en el centro colocan el dispositivo móvil. Luego tocan el botón parpadeante para girar la botella. El jugador señalado por la botella debe cumplir el reto que lanza la aplicación; de lo contrario, abandona el juego."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="36dp" />

            <!-- Título: Quién gana -->
            <TextView
                android:id="@+id/tvTituloQuienGana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quién gana"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_gravity="start"
                android:background="@color/instrucciones_acento"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvDescQuienGana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gana el último jugador que no abandone el juego."
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="40dp" />

            <!-- Imagen/GIF -->
            <ImageView
                android:id="@+id/ivTriunfo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:contentDescription="Animación de triunfo" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>