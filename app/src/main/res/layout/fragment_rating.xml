<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rating"
    android:padding="24dp">

    <!-- ── Pantalla principal de rating ── -->
    <LinearLayout
        android:id="@+id/layoutRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Icono de la app -->
        <ImageView
            android:id="@+id/ivIconoApp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="App icon"
            android:src="@mipmap/ic_launcher" />

        <!-- Mensaje principal (cambia segun estrellas) -->
        <TextView
            android:id="@+id/tvMensajePrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cómo te parece?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Subtitulo (cambia segun estrellas) -->
        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuéntanos tu experiencia"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Fila de 5 estrellas -->
        <LinearLayout
            android:id="@+id/layoutEstrellas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/star1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Estrella 1" />

            <ImageView
                android:id="@+id/star2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Estrella 2" />

            <ImageView
                android:id="@+id/star3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Estrella 3" />

            <ImageView
                android:id="@+id/star4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Estrella 4" />

            <ImageView
                android:id="@+id/star5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_empty"
                android:contentDescription="Estrella 5" />

        </LinearLayout>

        <!-- Boton Calificar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calificar"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"
            app:backgroundTint="#FF4500" />

        <!-- Boton Ahora no -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMasTarde"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ahora no"
            android:textColor="#FF4500" />

    </LinearLayout>

    <!-- ── Pantalla de gracias (oculta inicialmente) ── -->
    <LinearLayout
        android:id="@+id/layoutGracias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Gracias! 🎉"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu opinión nos ayuda a mejorar."
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>