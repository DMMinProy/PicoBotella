<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp"> <LinearLayout
    android:id="@+id/containerDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginTop="40dp"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <View
        android:id="@+id/viewPokemonPlaceholder"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvChallengeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="¡Aquí irá la descripción del reto aleatorio traído de la base de datos!" />

</LinearLayout>

    <Button
        android:id="@+id/btnDismissChallenge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF9800"
        android:text="Cerrar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/containerDialog"
        app:layout_constraintTop_toBottomOf="@+id/containerDialog"
        app:layout_constraintStart_toStartOf="@+id/containerDialog"
        app:layout_constraintEnd_toEndOf="@+id/containerDialog" />

</androidx.constraintlayout.widget.ConstraintLayout>