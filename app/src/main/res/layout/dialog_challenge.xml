<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="60dp" android:paddingBottom="32dp"> <LinearLayout
    android:id="@+id/containerDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="32dp" android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="70dp" android:paddingBottom="45dp" app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/tvChallengeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp" tools:text="Realiza un RecyclerView que liste una api de Pokemones" />

</LinearLayout>

    <ImageView
        android:id="@+id/imgPokemon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/pokemon_circle_background"
        android:padding="12dp"
        android:elevation="6dp" app:layout_constraintTop_toTopOf="@+id/containerDialog"
        app:layout_constraintBottom_toTopOf="@+id/containerDialog"
        app:layout_constraintStart_toStartOf="@+id/containerDialog"
        app:layout_constraintEnd_toEndOf="@+id/containerDialog"
        tools:src="@tools:sample/avatars" />

    <Button
        android:id="@+id/btnDismissChallenge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF4500"
        android:text="Cerrar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:paddingHorizontal="24dp" android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/containerDialog"
        app:layout_constraintTop_toBottomOf="@+id/containerDialog"
        app:layout_constraintStart_toStartOf="@+id/containerDialog"
        app:layout_constraintEnd_toEndOf="@+id/containerDialog" />

</androidx.constraintlayout.widget.ConstraintLayout>