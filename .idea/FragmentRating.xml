<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_rating.xml
    Bottom sheet de calificación – estilo Nequi
    Coloca este archivo en: res/layout/fragment_rating.xml
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rating"
    android:paddingBottom="32dp">

    <!-- ───── Handle ───── -->
    <View
        android:id="@+id/handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════════════════════════════════════════
         PANTALLA PRINCIPAL DE RATING
    ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ícono de la app -->
        <ImageView
            android:id="@+id/ivIconoApp"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name" />

        <!-- Título dinámico -->
        <TextView
            android:id="@+id/tvMensajePrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cómo vas?"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/rating_text_primary"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginBottom="8dp" />

        <!-- Subtítulo dinámico -->
        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuéntanos cómo ha sido\ntu experiencia con la app."
            android:textSize="15sp"
            android:textColor="@color/rating_text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginBottom="28dp" />

        <!-- ── Estrellas ── -->
        <LinearLayout
            android:id="@+id/layoutEstrellas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/star1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_star_empty"
                android:padding="4dp"
                android:background="@drawable/bg_star_ripple"
                android:contentDescription="1 estrella" />

            <ImageView
                android:id="@+id/star2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_star_empty"
                android:padding="4dp"
                android:background="@drawable/bg_star_ripple"
                android:contentDescription="2 estrellas" />

            <ImageView
                android:id="@+id/star3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_star_empty"
                android:padding="4dp"
                android:background="@drawable/bg_star_ripple"
                android:contentDescription="3 estrellas" />

            <ImageView
                android:id="@+id/star4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_star_empty"
                android:padding="4dp"
                android:background="@drawable/bg_star_ripple"
                android:contentDescription="4 estrellas" />

            <ImageView
                android:id="@+id/star5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_star_empty"
                android:padding="4dp"
                android:background="@drawable/bg_star_ripple"
                android:contentDescription="5 estrellas" />

        </LinearLayout>

        <!-- Botón principal: Calificar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalificar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Calificar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@color/rating_primary"
            app:cornerRadius="28dp"
            app:elevation="0dp" />

        <!-- Botón secundario: Más tarde -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMasTarde"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ahora no"
            android:textSize="14sp"
            android:textColor="@color/rating_text_secondary"
            android:fontFamily="@font/poppins_regular"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="@color/rating_ripple" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         PANTALLA DE GRACIAS (se muestra al calificar)
    ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutGracias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="40dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Emoji de celebración -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="64sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Gracias por tu opinión!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/rating_text_primary"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu calificación nos ayuda a\nmejorar cada día."
            android:textSize="15sp"
            android:textColor="@color/rating_text_secondary"
            android:gravity="center"
            android:fontFamily="@font/poppins_regular" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
